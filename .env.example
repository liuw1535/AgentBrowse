# OpenAI配置
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4
TEMPERATURE=0.7

# 浏览器配置
BROWSER_HEADLESS=true
BROWSER_TIMEOUT=30000
BROWSER_USER_AGENT=
BROWSER_STEALTH_MODE=true  # 启用反自动化检测模式，减少被网站识别为机器人的风险

# API配置
API_HOST=0.0.0.0
API_PORT=8000
API_KEY=

# Agent配置
MAX_ITERATIONS=10
MEMORY_KEY=chat_history
VERBOSE=true

# 日志配置
LOG_LEVEL=INFO